# /.inputrc - readline key bindings for AMIX's interactive bash (root: /.inputrc).
#
# macOS's Delete key sends DEL (0x7f = \C-?); base bash here only had ^H (0x08)
# bound to erase, so the physical Delete key misbehaved. Map both to erase-left,
# and fn-Delete (the VT "\e[3~" sequence) to forward-delete. readline reads this
# for ANY interactive bash, so it fixes both the revsh and the ssh-tunnel paths.

set editing-mode emacs
"\C-?": backward-delete-char     # DEL (0x7f) - macOS Delete key
"\C-h": backward-delete-char     # BS  (0x08) - Ctrl-H
"\e[3~": delete-char             # fn-Delete / forward-delete
